---
interface Props {
  items: { id: string; label: string }[];
}
const { items } = Astro.props;
---
<aside class="toc">
  <nav aria-label="On this page">
    <h2>On this page</h2>
    <ol>
      {items.map((item) => <li><a href={`#${item.id}`}>{item.label}</a></li>)}
    </ol>
  </nav>
</aside>
<script>
  const links = [...document.querySelectorAll<HTMLAnchorElement>(".toc a")];
  const targets = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((el): el is HTMLElement => el !== null);
  const observer = new IntersectionObserver(
    (entries) => {
      for (const entry of entries) {
        if (!entry.isIntersecting) continue;
        for (const link of links) {
          if (link.hash === `#${entry.target.id}`) link.setAttribute("aria-current", "location");
          else link.removeAttribute("aria-current");
        }
      }
    },
    { rootMargin: "-20% 0px -70% 0px" },
  );
  targets.forEach((target) => observer.observe(target));

  // The explorer spans the sidebar column, so hide the TOC while it overlaps the sticky nav.
  const toc = document.querySelector(".toc");
  const wide = document.querySelector(".explorer-wide");
  if (toc && wide) {
    new IntersectionObserver(
      ([entry]) => toc.classList.toggle("is-hidden", entry.isIntersecting),
      { rootMargin: "-80px 0px -35% 0px" },
    ).observe(wide);
  }
</script>
