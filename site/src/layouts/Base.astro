---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>;
  indexable?: boolean;
}
const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
const {
  title,
  description,
  image = `${base}og-image.png`,
  imageAlt = "EmDash Cyber: How are .au domains configured for email?",
  jsonLd,
  indexable = true,
} = Astro.props;
const canonical = indexable ? new URL(Astro.url.pathname, Astro.site).href : undefined;
const imageUrl = new URL(image, Astro.site).href;
// Escape < so JSON-LD cannot close the script element.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : undefined;
const year = new Date().getFullYear();
// GitHub Pages cannot send headers, so the policy ships as a meta tag; dev tooling needs inline scripts.
const csp = "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; base-uri 'self'; form-action 'none'";
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    {import.meta.env.PROD && <meta http-equiv="Content-Security-Policy" content={csp} />}
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={indexable ? "index, follow, max-image-preview:large" : "noindex"} />
    <meta name="author" content="EmDash Cyber" />
    {canonical && <link rel="canonical" href={canonical} />}
    <link rel="icon" href={`${base}emdash-mark.svg`} type="image/svg+xml" />
    <link rel="icon" href={`${base}favicon-32.png`} type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href={`${base}apple-touch-icon.png`} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EmDash Cyber" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
    <script is:inline src={`${base}theme.js`}></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="https://emdashcyber.com/">
          <img src={`${base}emdash-mark.svg`} alt="" width="26" height="26" />
          <span>EmDash Cyber</span>
        </a>
        <nav class="crumb" aria-label="Breadcrumb">/ <a href={base}>DMARC.au</a></nav>
        <div class="header-actions">
          <a class="header-link" href="https://github.com/emdashcyber/dmarc-au">
            <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z" /></svg>
            <span>GitHub</span>
          </a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false">
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path fill="currentColor" d="M20.9 13.1A8.5 8.5 0 0 1 10.9 3.1a8.5 8.5 0 1 0 10 10Z" /></svg>
            <span>Dark Mode</span>
          </button>
        </div>
      </div>
    </header>
    <main id="main" class="page" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="site-footer-inner">
        <a class="brand footer-brand" href="https://emdashcyber.com/">
          <img src={`${base}emdash-mark.svg`} alt="" width="22" height="22" />
          <span>EmDash Cyber</span>
        </a>
        <span>&copy; {year} EmDash Cyber</span>
      </div>
    </footer>
  </body>
</html>
