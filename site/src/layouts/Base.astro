---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  image?: string;
  imageAlt?: string;
  jsonLd?: Record<string, unknown>;
}
const base = import.meta.env.BASE_URL;
const {
  title,
  description,
  image = `${base}og-image.png`,
  imageAlt = "EmDash Cyber: How are .au domains configured for email?",
  jsonLd,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site).href;
const imageUrl = new URL(image, Astro.site).href;
// Escape < so JSON-LD cannot close the script element.
const jsonLdText = jsonLd ? JSON.stringify(jsonLd).replace(/</g, "\\u003c") : undefined;
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="author" content="EmDash Cyber" />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="EmDash Cyber" />
    <meta property="og:locale" content="en_AU" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:type" content="image/png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={imageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />
    <meta name="twitter:image:alt" content={imageAlt} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#fcfcfb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    {jsonLdText && <script type="application/ld+json" set:html={jsonLdText} />}
    <script is:inline>
      (() => {
        const saved = localStorage.getItem("theme");
        const theme = saved || (matchMedia("(prefers-color-scheme: dark)").matches ? "dark" : "light");
        document.documentElement.dataset.theme = theme;
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <div class="site-header-inner">
        <a class="brand" href="https://emdashcyber.com/">
          <img src={`${base}emdash-mark.svg`} alt="" width="26" height="26" />
          <span>EmDash Cyber</span>
        </a>
        <span class="crumb" aria-hidden="true">/ <a href={base}>DMARC .au</a></span>
        <div class="header-actions">
          <a class="header-link" href="https://github.com/emdashcyber/dmarc-au">GitHub</a>
          <button class="theme-toggle" id="theme-toggle" type="button" aria-pressed="false">Dark mode</button>
        </div>
      </div>
    </header>
    <main id="main" class="page" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">&copy; 2026 EmDash Cyber</footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.getElementById("theme-toggle");
        const sync = () => button.setAttribute("aria-pressed", String(root.dataset.theme === "dark"));
        sync();
        button.addEventListener("click", () => {
          root.dataset.theme = root.dataset.theme === "dark" ? "light" : "dark";
          localStorage.setItem("theme", root.dataset.theme);
          sync();
        });
      })();
    </script>
  </body>
</html>
